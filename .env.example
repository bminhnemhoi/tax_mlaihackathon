# ==============================================================================
# TAX REFEREE - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép file này thành .env.local và điền các API key tương ứng:
# cp .env.example .env.local

# 1. ShopAIKey (Gemini Vision và Google Search grounding để đọc ảnh/tra cứu nhà cung cấp)
SHOPAIKEY_API_KEY=
SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
SHOPAIKEY_MODEL=gemini-2.5-flash

# 1b. LLM dành cho DEMO (chuẩn OpenAI chat/completions) — mặc định TẮT.
# Chỉ bật khi demo: DEV_LLM_ENABLED=1 và đủ 3 biến dưới. Ảnh hóa đơn sẽ đi tới máy chủ này
# (ghi rõ khi trình bày phần riêng tư). XML không bao giờ đi qua AI. Không commit giá trị thật.
DEV_LLM_ENABLED=
DEV_LLM_BASE_URL=
DEV_LLM_API_KEY=
DEV_LLM_MODEL=

# Tra cứu dữ liệu thuế có cấu trúc (tùy chọn); thiếu khóa vẫn dùng ShopAIKey grounding.
XINVOICE_CLIENT_ID=
XINVOICE_API_KEY=
# Tìm ứng viên theo tên; ứng viên vẫn phải được đối chiếu dữ liệu thuế trước khi điền.
DOANHNGHIEP_API_KEY=

# 2. OpenRouter và Qwen (tùy chọn) — đường quyết định KHÔNG đọc các biến này (0 lần gọi LLM).
# OPENROUTER_*: dùng bởi services/qwenService.ts, mà chỉ script trong scripts/ (QA, benchmark) gọi tới.
#   Trong ứng dụng, OPENROUTER_* chỉ là phương án dự phòng cuối của lib/constants.ts (GEMINI_API_CONFIG)
#   khi không có SHOPAIKEY_*/AI_*, cho tính năng diễn đạt câu hỏi bằng AI (QGEN_AI, tắt mặc định).
#   Đọc ảnh/PDF scan và tra cứu MST không dùng OPENROUTER_* (dùng SHOPAIKEY_* và các khóa tra cứu ở mục 1).
#   Để trống nếu không chạy các script trên.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Ghi chú 10/10 (khi OpenRouter còn dùng để đọc ảnh): các model khác đã benchmark, không model nào đạt
# < 2 giây với ảnh mới kèm độ chính xác; xem docs/qa-2026-10-10/PERFORMANCE.md.
# QWEN_*: chỉ services/qwenService.ts đọc; ứng dụng không import file này, chỉ script trong scripts/ dùng.
QWEN_API_KEY=
QWEN_BASE_URL=https://ws-0shshb54xxvk987d.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus-character

# 3. Cấu hình Máy chủ & Cổng mạng
PORT=3000
# URL công khai tùy chọn nếu proxy không gửi đúng host. Khi để trống,
# QR dùng host hiện tại; ở môi trường dev, localhost tự lấy IPv4 đang hoạt động.
APP_PUBLIC_URL=

# 4. Cấu hình Database & Tài khoản nội bộ
TAX_REFEREE_DB_PATH=./data/runtime/tax_referee.db
TAX_REFEREE_ACCOUNTANT_PASSWORD=
TAX_REFEREE_KTT_PASSWORD=
TAX_REFEREE_CFO_PASSWORD=
# Workspace nội bộ dùng chung chỉ cho đăng nhập email/mật khẩu. Đặt =1 nếu muốn bật chọn vai trò không mật khẩu
# (KHÔNG khuyến nghị: ai cũng thành CFO được). Giám khảo/khách luôn dùng demo riêng, đổi vai trò tự do trong phiên.
TAX_REFEREE_ALLOW_INTERNAL_ROLE_LOGIN=
# Số database demo giữ mở trong bộ nhớ; quá ngưỡng sẽ đóng phiên ít dùng nhất (không từ chối người mới).
TAX_REFEREE_DEMO_CACHE=200
# Số phiên demo mới mỗi giờ mỗi IP (mặc định 200) và tổng số database demo tối đa (mặc định 2000).
TAX_REFEREE_DEMO_PER_HOUR=
TAX_REFEREE_DEMO_MAX=

# 5. Nhật ký chống sửa (audit)
# Khóa HMAC cho chuỗi audit (≥ 32 ký tự, ngẫu nhiên, KHÔNG commit). Có khóa thì người chỉ sửa được file DB không thể tính lại chuỗi.
# Production để trống: tự sinh khóa 32 byte vào file .audit-key (quyền 600) cạnh database ở lần chạy đầu.
TAX_REFEREE_AUDIT_KEY=
# Đường dẫn file khóa tự sinh (mặc định .audit-key trong thư mục chứa file database); đặt =off để tắt tự sinh.
TAX_REFEREE_AUDIT_KEY_FILE=
# Mốc thời gian ISO 8601 (ví dụ 2026-10-16T00:00:00Z): từ mốc này mọi sự kiện phải có HMAC — chống hạ cấp chữ ký.
TAX_REFEREE_AUDIT_SIGNED_SINCE=

# 6. Ngân sách gọi AI (OWASP LLM10) — vượt trần thì không gọi AI, người dùng nhập tay hoặc tải XML
# Đọc ảnh/PDF scan: mỗi người dùng mỗi giờ (mặc định 60) và toàn tiến trình mỗi giờ (mặc định 600).
TAX_REFEREE_PARSE_PER_HOUR=
TAX_REFEREE_VISION_GLOBAL_PER_HOUR=
# Tra cứu MST có grounding: mỗi phiên mỗi giờ (mặc định 60) và toàn tiến trình mỗi giờ (mặc định 300).
TAX_REFEREE_GROUNDING_PER_SESSION_HOUR=
TAX_REFEREE_GROUNDING_PER_HOUR=
# Tra cứu nhà cung cấp thủ công: mỗi người dùng mỗi giờ (mặc định 60).
TAX_REFEREE_LOOKUP_PER_HOUR=
# Diễn đạt câu hỏi chuyển tiếp bằng AI: để trống = tắt (khuyến nghị); =1 để bật, /api/health (production) sẽ cảnh báo.
QGEN_AI=

# 7. Cập nhật văn bản pháp luật
# Khóa webhook cập nhật văn bản pháp luật (≥ 24 ký tự). Để trống = tắt webhook.
LEGAL_WEBHOOK_SECRET=
LEGAL_UPDATE_FEED_URLS=

# 8. Thư mục bền vững gồm database / chứng từ / phiên demo / khóa audit tự sinh
TAX_REFEREE_DATA_DIR=./data/runtime

# 9. Phiên bản bản build (tùy chọn). Thường không cần: commit được ghi tự động lúc `npm run build` từ git.
GIT_COMMIT_SHA=

# 10. Kênh nhận / gửi hóa đơn thật (tùy chọn). Thiếu biến ⇒ màn hình Hộp thư vào hiện "Chưa cấu hình"; chỉ tên biến nằm trong repo.
# Gmail: tài khoản Gmail nhận hóa đơn + App Password (Bảo mật Google > Mật khẩu ứng dụng). IMAP imap.gmail.com:993 TLS, SMTP smtp.gmail.com:465.
GMAIL_IMAP_USER=
GMAIL_APP_PASSWORD=
# Email Kế toán trưởng nhận bản tóm tắt sau mỗi lượt lấy hóa đơn
GMAIL_NOTIFY_TO=
# Zalo Bot Platform: token của bot và chat id nhận bản tóm tắt cho Kế toán trưởng
ZALO_BOT_TOKEN=
ZALO_NOTIFY_CHAT_ID=
# Bí mật cho bộ hẹn giờ ngoài gọi lấy hóa đơn định kỳ (dự phòng; bản hiện tại kiểm tra từ trình duyệt mỗi 60 giây)
TAX_REFEREE_CHANNEL_POLL_SECRET=
