# ==============================================================================
# TAX REFEREE - CẤU HÌNH BIẾN MÔI TRƯỜNG (ENVIRONMENT CONFIGURATION)
# ==============================================================================
# Sao chép file này thành .env.local và điền các API key tương ứng:
# cp .env.example .env.local

# 1. OpenRouter API (Đọc ảnh hóa đơn Vision OCR với Qwen 3.7 Flash)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.7-flash
# Model alternatives were benchmarked; none met fresh-image <2s + accuracy.
# See docs/qa-2026-10-10/PERFORMANCE.md before changing this value.

# 2. Alibaba Cloud Model Studio (Qwen - Tầng suy luận & Phán quyết A/B)
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://ws-0shshb54xxvk987d.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus-character

# 3. TypeSafe AI System One (Jev API - Tùy chọn tăng tốc phân loại)
TYPESAFE_API_KEY=your_typesafe_api_key_here

# 4. Cấu hình Máy chủ & Cổng mạng
PORT=3000
# Domain công khai, cần thiết khi reverse proxy cung cấp URL nội bộ cho Next.js.
# Bỏ trống để tự dùng origin của request (ví dụ local).
APP_PUBLIC_URL=
LOCAL_IMAGE_PREFLIGHT=true

# 5. Cấu hình Database & Tài khoản nội bộ
TAX_REFEREE_DB_PATH=./data/runtime/tax_referee.db
TAX_REFEREE_ACCOUNTANT_PASSWORD=
TAX_REFEREE_KTT_PASSWORD=
TAX_REFEREE_CFO_PASSWORD=
LEGAL_UPDATE_FEED_URLS=

# Thư mục bền vững gồm database / chứng từ / phiên demo
TAX_REFEREE_DATA_DIR=./data/runtime

# Local OCR hybrid routing. Clear OPENROUTER_API_KEY disables the paid fallback
# and leaves low-confidence cases in the manual-review queue.
DOCUMENT_IMAGE_ENGINE=local-ocr
LOCAL_OCR_URL=http://127.0.0.1:3004
LOCAL_OCR_PROFILE=max960
LOCAL_OCR_TIMEOUT_MS=2200
LOCAL_OCR_QWEN_FALLBACK=true
# confidence-gated semantic extraction from the compact OCR transcript;
# use "vision" only when the provider must inspect the original image
LOCAL_OCR_AI_MODE=text
LOCAL_OCR_AI_TIMEOUT_MS=1800
LOCAL_OCR_MIN_AVERAGE_CONFIDENCE=0.82
LOCAL_OCR_MAX_LOW_CONFIDENCE_RATIO=0.35
