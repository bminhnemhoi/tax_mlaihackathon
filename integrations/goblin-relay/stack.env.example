# stack.env: cấu hình bộ chạy trên MỘT máy (relay-local-stack.sh). Chép thành ~/.config/goblin-tax-test/stack.env, chmod 600, KHÔNG commit, KHÔNG gửi lên chat.
# Token chung với bot Goblin: phải GIỐNG RELAY_<ĐÍCH>_TOKEN trong .env của bot. Tạo: openssl rand -hex 24
RELAY_TOKEN=
RELAY_BIND=127.0.0.1          # đặt IP Tailscale của máy này để bot trên VPS gọi tới được (tailscale ip -4). KHÔNG đặt 0.0.0.0
RELAY_PORT=8787
RELAY_INBOX=/duong/dan/relay-inbox

# Tax Referee chạy tại máy này (thư mục đã npm ci bằng Node 22; cần có .env.local của tax)
TAX_DIR=/duong/dan/Tax-Referee
TAX_PORT=3100
# Cách bộ nhận đăng nhập tax: password (tài khoản nội bộ, hóa đơn hiện trong hộp thẩm định của tài khoản đó) | demo | none
TAX_AUTH=password
TAX_EMAIL=
TAX_PASSWORD=
TAX_EVALUATE=1

# Cầu nối đọc ảnh: bắt buộc nếu ảnh/PDF scan đi qua 9Router (xem README: vì sao cần cầu nối)
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://<máy chủ 9Router>/v1
GATEWAY_MODEL=ag/gemini-3.8-flash-medium
ADAPTER_PORT=8790
ADAPTER_TOKEN=                # chuỗi bất kỳ; điền cùng giá trị vào SHOPAIKEY_API_KEY trong .env.local của tax
