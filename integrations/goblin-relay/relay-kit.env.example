# relay-kit.env - cấu hình máy demo (sao chép file này thành relay-kit.env rồi điền). KHÔNG commit, KHÔNG gửi lên chat.
# Token chung với VPS: phải GIỐNG RELAY_TAX_TOKEN trên VPS. Tạo mới: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
RELAY_TOKEN=
# auto = tự dùng IP Tailscale của máy này (khuyên dùng). Đừng đặt 0.0.0.0
RELAY_BIND=auto
RELAY_PORT=8787
RELAY_INBOX=./relay-inbox
# Địa chỉ Tax Referee chạy trên máy này (xem cổng bạn đang chạy). Bỏ trống = chỉ lưu file, không chuyển vào tax
TAX_BASE_URL=http://127.0.0.1:3000
# Cách receiver đăng nhập vào tax để đưa hóa đơn vào hộp thẩm định: password (khuyên dùng) | demo | none
TAX_AUTH=password
TAX_EMAIL=
TAX_PASSWORD=
# 1 = đưa hóa đơn vào thẩm định như nút "Thẩm định" trên web
TAX_EVALUATE=1
# (Tùy chọn) Chỉ điền nếu tax của máy này cần đọc ảnh qua cổng AI 9Router của nhóm (đường OpenAI, qua Tailscale). Bỏ trống nếu tax đã có khóa AI riêng
GATEWAY_API_KEY=
GATEWAY_BASE_URL=
GATEWAY_MODEL=ag/gemini-3.8-flash-medium
ADAPTER_PORT=8790
ADAPTER_TOKEN=
